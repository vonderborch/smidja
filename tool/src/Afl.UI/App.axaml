<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Afl.UI.Views"
             xmlns:dc="using:Afl.UI.DataContexts"
             x:Class="Afl.UI.App">
    <!-- Loaded by App.Initialize after the Fluent theme that Niddy adds. -->
    <Application.Resources>
        <FontFamily x:Key="MonoFont">Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>
        <!-- A context menu's item built from a dc:MenuChoice (its text is the choice's ToString), ticked as the choice says -->
        <ControlTheme x:Key="ChoiceMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="dc:MenuChoice">
            <Setter Property="ToggleType" Value="{Binding ToggleType}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
        </ControlTheme>
        <!-- One command or tool the agent was refused: allow it once or always (with the rule and where to save it), or deny it -->
        <DataTemplate x:Key="PermissionRequestRow" x:DataType="dc:PermissionRequestDataContext">
            <StackPanel Spacing="6">
                <SelectableTextBlock Text="{Binding Label}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" />
                <WrapPanel Orientation="Horizontal">
                    <ToggleButton Content="Allow once" IsChecked="{Binding IsOnce}" Margin="0,0,6,6" />
                    <ToggleButton Content="Always allow" IsChecked="{Binding IsAlways}" Margin="0,0,6,6" />
                    <ToggleButton Content="Deny" IsChecked="{Binding IsDenied}" Margin="0,0,6,6" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsDenied}">
                    <TextBlock Text="Rule" VerticalAlignment="Center" />
                    <AutoCompleteBox Text="{Binding Rule}" ItemsSource="{Binding Rules}" MinWidth="320"
                                     FilterMode="None" MinimumPrefixLength="0"
                                     ToolTip.Tip="What to allow: pick a suggestion (most specific first) or type your own rule" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAlways}">
                    <TextBlock Text="Save to" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ScopeChoices}" SelectedItem="{Binding Scope}" MinWidth="100"
                              ToolTip.Tip="Run: this run only. Repo: every run in this repo. Global: every run anywhere." />
                </StackPanel>
                <TextBlock Classes="error" Margin="0" TextWrapping="Wrap" Text="{Binding RuleProblem}"
                           IsVisible="{Binding RuleProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DataTemplate>
        <!-- One question asked now, with the editor its input type uses -->
        <DataTemplate x:Key="StepInputRow" x:DataType="dc:StepInputDataContext">
            <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" IsVisible="{Binding !IsToggle}" />
                <TextBlock Text="{Binding Help}" Classes="meta" TextWrapping="Wrap"
                           IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" MinWidth="320"
                         IsVisible="{Binding IsText}" />
                <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                         MinWidth="320" IsVisible="{Binding IsMultiline}" />
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}" MinWidth="240"
                          PlaceholderText="Pick one" IsVisible="{Binding IsChoice}" />
                <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsMultiChoice}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="16" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type dc:SelectableItem, x:TypeArguments=x:String}">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsVisible="{Binding IsToggle}" />
                <TextBlock Text="{Binding Error}" Classes="error" Margin="0" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DataTemplate>
    </Application.Resources>

    <Application.Styles>
        <!-- Shared text and panel styles for the afl pages -->
        <Style Selector="TextBlock.h1, SelectableTextBlock.h1">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="IndianRed" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="Foreground" Value="SeaGreen" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.prompt">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="views|MarkdownView.prompt">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector=":is(Button).markdown">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Border.card.popup">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #50000000" />
        </Style>
        <Style Selector="Border.step">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumLowBrush}" />
        </Style>
        <Style Selector="Border.nested">
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>
        <Style Selector="Border.step.skipped">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.console">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.needs">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.meta.waiting">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.toggle.expanded > Path">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="Button.tag">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.tag.picked">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
        </Style>
        <Style Selector="Button.tag.state">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.tag.state.picked">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="4">
                        <ContentPresenter Content="{TemplateBinding Header}" FontSize="12" Opacity="0.75" />
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
