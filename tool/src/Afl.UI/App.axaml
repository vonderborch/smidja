<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Afl.UI.Views"
             xmlns:dc="using:Afl.UI.DataContexts"
             x:Class="Afl.UI.App">
    <!-- Loaded by App.Initialize after the Fluent theme that Niddy adds. -->
    <Application.Resources>
        <FontFamily x:Key="MonoFont">Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>
        <!-- A context menu's item built from a dc:MenuChoice (its text is the choice's ToString), ticked as the choice says -->
        <ControlTheme x:Key="ChoiceMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="dc:MenuChoice">
            <Setter Property="ToggleType" Value="{Binding ToggleType}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <!-- Shared text and panel styles for the afl pages -->
        <Style Selector="TextBlock.h1, SelectableTextBlock.h1">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="IndianRed" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="Foreground" Value="SeaGreen" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.prompt">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="views|MarkdownView.prompt">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector=":is(Button).markdown">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Border.card.popup">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #50000000" />
        </Style>
        <Style Selector="Border.step">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumLowBrush}" />
        </Style>
        <Style Selector="Border.nested">
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>
        <Style Selector="Border.step.skipped">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.console">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.needs">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.meta.waiting">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.toggle.expanded > Path">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="Button.tag">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.tag.picked">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
        </Style>
        <Style Selector="Button.tag.state">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.tag.state.picked">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="4">
                        <ContentPresenter Content="{TemplateBinding Header}" FontSize="12" Opacity="0.75" />
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
