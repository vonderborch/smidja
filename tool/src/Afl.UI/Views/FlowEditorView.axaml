<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:flow="using:Afl.UI.Flow"
             xmlns:dc="using:Afl.UI.DataContexts"
             xmlns:views="using:Afl.UI.Views"
             x:Class="Afl.UI.Views.FlowEditorView"
             x:DataType="flow:FlowGraphDataContext">

    <UserControl.DataTemplates>
        <!-- What each kind of arrow's mini editor adds under where it goes -->
        <DataTemplate DataType="flow:ArrowDataContext">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,*">
                    <HeaderedContentControl Grid.Column="0" Header="Fires on" Margin="0,0,6,0">
                        <ComboBox ItemsSource="{x:Static dc:ArrowDraftDataContext.OnChoices}" SelectedItem="{Binding Arrow.On}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="success (default), failure (handles it), timeout, or always (runs either way, like finally)." />
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="1" Header="Condition">
                        <ComboBox ItemsSource="{x:Static dc:ArrowDraftDataContext.ConditionModes}" SelectedItem="{Binding Arrow.ConditionMode}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="when…: taken only while the condition holds. until…: taken until it holds." />
                    </HeaderedContentControl>
                </Grid>
                <ContentControl Content="{Binding Arrow.Condition}" IsVisible="{Binding Arrow.HasCondition}" />
                <Border Classes="arrowSection" IsVisible="{Binding IsLoop}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="The loop" />
                        <HeaderedContentControl Header="At most (times)">
                            <NumericUpDown Value="{Binding Arrow.Max}" Minimum="1" Maximum="100" Increment="1" FormatString="0" PlaceholderText="5" />
                        </HeaderedContentControl>
                        <CheckBox Content="Move on at the limit" IsChecked="{Binding Arrow.MoveOnAtLimit}"
                                  ToolTip.Tip="At the limit, treat the arrow as not taken instead of failing the step." />
                    </StackPanel>
                </Border>
                <HeaderedContentControl Header="Label (optional)">
                    <TextBox Text="{Binding Arrow.Label}" PlaceholderText="shown on the graph instead of the condition" />
                </HeaderedContentControl>
                <Border Classes="arrowSection" IsVisible="{Binding Step.IsFork}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="Parallel paths" />
                        <HeaderedContentControl Header="Paths work in">
                            <ComboBox ItemsSource="{x:Static dc:StepDraftDataContext.WorkspaceChoices}" SelectedItem="{Binding Step.Workspace}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="shared (default): the run's checkout. worktree: each path gets its own git worktree, merged back where the paths meet." />
                        </HeaderedContentControl>
                        <CheckBox Content="Merge each path's work back where they meet" IsChecked="{Binding Step.MergeBack}"
                                  IsVisible="{Binding Step.ShowsMergeBack}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="Border.flowCanvas">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.flowNode">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #26000000" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.flowNode:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Border.flowNode.error">
            <Setter Property="BorderBrush" Value="#EF4444" />
        </Style>
        <Style Selector="Border.flowNode.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.flowNode.reached">
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.flowNode.active">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.flowNode.failedRun">
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Panel.faded">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.outcome">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="Border.marquee">
            <Setter Property="Background" Value="#1A3B82F6" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.flowTerminal">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.flowBadge">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Ellipse.connectHandle">
            <Setter Property="Fill" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Cross" />
        </Style>
        <Style Selector="Ellipse.connectHandle:pointerover">
            <Setter Property="Fill" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="Border.pickerCard">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #40000000" />
        </Style>
        <Style Selector="Border.arrowCard">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.arrowSection">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,8,0,0" />
        </Style>
        <Style Selector="Ellipse.arrowHandle">
            <Setter Property="Fill" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Button.pickerItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <DockPanel>
                <!-- Adding steps -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,6" IsVisible="{Binding !IsReadOnly}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddStepButton" Classes="accent" Content="+ Add step" Click="OnAddStep" IsEnabled="{Binding CanEdit}"
                            ToolTip.Tip="Add a step after the selected one (or on its own when none is)" />
                    <Button x:Name="TidyButton" Content="Tidy" Click="OnTidy" IsEnabled="{Binding HasMovedSteps}" IsVisible="{Binding CanEdit}"
                            ToolTip.Tip="Lay every step out again, forgetting where steps were moved to" />
                    <ToggleButton x:Name="SimulateButton" Content="Simulate" IsChecked="{Binding IsSimulating}"
                                  ToolTip.Tip="See how a run would go: pick how each step ends and whether each conditional arrow is taken" />
                    <TextBlock x:Name="Hint" Classes="meta" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding !IsSimulating}"
                               Text="Click a step or an arrow to edit it · drag a step to move it, or its → handle to another step to draw an arrow · drag on the canvas or ⇧-click to pick several · right-click for more" />
                    <TextBlock x:Name="SimulationSummary" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding IsSimulating}" Text="{Binding OverlaySummary}"
                               ToolTip.Tip="Click a step's ‘ends’ button to change how it ends, and a conditional arrow or an arrow back to take it or not" />
                </StackPanel>
            </Border>

            <!-- The open arrow's mini editor -->
            <Border x:Name="ArrowEditor" Classes="arrowCard" DockPanel.Dock="Right" IsVisible="{Binding IsArrowOpen}" Width="340"
                    Margin="8,0,0,0">
                <ScrollViewer DataContext="{Binding Arrow}" x:DataType="flow:AbstractFlowArrowDataContext">
                    <StackPanel Spacing="8" Margin="0,0,12,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseArrow" Padding="8,2" Background="Transparent"
                                    VerticalAlignment="Top" ToolTip.Tip="Close (Esc)" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Heading}" Classes="meta" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Help}" Classes="meta" TextWrapping="Wrap" />
                        <HeaderedContentControl Header="Goes to">
                            <ComboBox x:Name="ArrowTarget" ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding Target}"
                                      HorizontalAlignment="Stretch" />
                        </HeaderedContentControl>
                        <ContentControl Content="{Binding}" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="{Binding RemoveLabel}" Click="OnRemoveArrow" Margin="8,0,0,0" />
                            <TextBlock Classes="meta" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Drag the dot at the arrow's end onto another step to repoint it." />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Making a step conditional -->
            <Border x:Name="ConditionalEditor" Classes="arrowCard" DockPanel.Dock="Right" IsVisible="{Binding IsConditionalOpen}" Width="340"
                    Margin="8,0,0,0">
                <ScrollViewer DataContext="{Binding Conditional}" x:DataType="flow:ConditionalStepDataContext">
                    <StackPanel Spacing="8" Margin="0,0,12,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseConditional" Padding="8,2" Background="Transparent"
                                    VerticalAlignment="Top" ToolTip.Tip="Close (Esc)" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="Make this step conditional" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Heading}" Classes="meta" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Classes="meta" TextWrapping="Wrap"
                                   Text="Go round the step when this holds. The arrows into it get 'not' the condition, and each step before it gets an arrow past it, so the steps after it still start." />
                        <ContentControl Content="{Binding Condition}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Click="OnCloseConditional" />
                            <Button Classes="accent" Content="Make conditional" Click="OnApplyConditional" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        <!-- The flow: nodes in layers from the start, and the arrows between them -->
        <Border Classes="flowCanvas" ClipToBounds="True">
            <Panel>
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Background>
                        <DrawingBrush TileMode="Tile" DestinationRect="0,0,18,18" Stretch="None">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="Transparent">
                                        <RectangleGeometry Rect="0,0,18,18" />
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#40888888">
                                        <EllipseGeometry Rect="8,8,2,2" />
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </ScrollViewer.Background>
                    <LayoutTransformControl x:Name="Zoomer" HorizontalAlignment="Center">
                        <Panel x:Name="Surface" Width="{Binding Width}" Height="{Binding Height}" Background="Transparent"
                               HorizontalAlignment="Left" VerticalAlignment="Top" PointerPressed="OnSurfacePressed"
                               ContextRequested="OnSurfaceContextRequested">
                            <views:FlowEdgeLayer Graph="{Binding}" IsHitTestVisible="False" />
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter" x:DataType="flow:FlowNodeDataContext">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="flow:FlowNodeDataContext">
                                        <Panel Width="{Binding Width}" Height="{Binding Height}" Classes.faded="{Binding IsFaded}">
                                            <Border Classes="flowTerminal" IsVisible="{Binding IsTerminal}">
                                                <TextBlock Text="{Binding Heading}" FontSize="12" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Classes="flowNode" Classes.selected="{Binding IsSelected}" Classes.error="{Binding HasError}"
                                                    Classes.reached="{Binding IsReached}" Classes.active="{Binding IsActive}"
                                                    Classes.failedRun="{Binding IsFailedRun}"
                                                    IsVisible="{Binding IsStep}" PointerPressed="OnNodePressed"
                                                    ContextRequested="OnNodeContextRequested">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="5" Background="{Binding Accent}" CornerRadius="5,0,0,5" />
                                                    <StackPanel Margin="10,0,12,0" Spacing="3" VerticalAlignment="Center">
                                                        <DockPanel>
                                                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Badges}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Border Classes="flowBadge">
                                                                            <TextBlock Text="{Binding}" FontSize="10" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Id}" Classes="meta" FontSize="11"
                                                                       FontFamily="{StaticResource MonoFont}" Margin="8,0,0,0" IsVisible="{Binding ShowsId}" />
                                                            <Button DockPanel.Dock="Right" Classes="outcome" Content="{Binding OutcomeText}"
                                                                    IsVisible="{Binding ShowsOutcome}" Click="OnCycleOutcome" Margin="8,0,0,0"
                                                                    ToolTip.Tip="How this step ends in the simulation: click for the next way" />
                                                            <TextBlock Text="{Binding Detail}" Classes="meta" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock Text="■ ends" Classes="meta" FontSize="10" IsVisible="{Binding Ends}" IsHitTestVisible="False"
                                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,-15"
                                                       ToolTip.Tip="The run ends after this step, unless a route's condition holds" />
                                            <TextBlock Text="{Binding Status}" Classes="meta" FontSize="10" IsVisible="{Binding HasStatus}"
                                                       IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Margin="0,0,8,-15" />
                                            <Panel Width="22" Height="22" Background="Transparent"
                                                   IsVisible="{Binding CanConnect}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-11,0"
                                                   Cursor="Cross" PointerPressed="OnHandlePressed"
                                                   ToolTip.Tip="Draw an arrow: drag to another step (or to itself, to run it again), or click here and then click it">
                                                <Ellipse Classes="connectHandle" Width="16" Height="16" IsHitTestVisible="False" />
                                                <TextBlock Text="→" FontSize="10" FontWeight="Bold" IsHitTestVisible="False"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                            </Panel>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The box being dragged out to pick steps -->
                            <Border x:Name="Marquee" Classes="marquee" IsVisible="False" IsHitTestVisible="False" />
                            <!-- The open arrow's end, dragged onto another step to repoint it -->
                            <Canvas IsHitTestVisible="False" IsVisible="{Binding HasArrowHandle}">
                                <Ellipse Classes="arrowHandle" Width="14" Height="14" Canvas.Left="{Binding ArrowHandleX}"
                                         Canvas.Top="{Binding ArrowHandleY}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-7" Y="-7" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Panel>
                    </LayoutTransformControl>
                </ScrollViewer>
                <!-- Zoom -->
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="−" Click="OnZoomOut" ToolTip.Tip="Zoom out (Ctrl+scroll)" Padding="8,2" />
                    <Button x:Name="ZoomReset" Content="100%" Click="OnZoomReset" ToolTip.Tip="Actual size" Padding="8,2" MinWidth="52" />
                    <Button Content="+" Click="OnZoomIn" ToolTip.Tip="Zoom in (Ctrl+scroll)" Padding="8,2" />
                    <Button Content="Fit" Click="OnZoomFit" ToolTip.Tip="Fit the whole flow" Padding="8,2" />
                </StackPanel>


                <!-- The picker for common steps and workflows to include -->
                <Border x:Name="PickerBackdrop" Background="#33000000" IsVisible="{Binding IsPickerOpen}"
                        PointerPressed="OnBackdropPressed">
                    <Border Classes="pickerCard" DataContext="{Binding Picker}" x:DataType="flow:FlowPickerDataContext"
                            Width="520" MaxHeight="520" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                            PointerPressed="OnPickerPressed">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="✕" Click="OnClosePicker" Padding="8,2"
                                        Background="Transparent" ToolTip.Tip="Close (Esc)" />
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="PickerSearch" DockPanel.Dock="Top" Text="{Binding Search}"
                                     PlaceholderText="Search by name, id, description or tag…" Margin="0,0,0,8" />
                            <views:TagFilterView DockPanel.Dock="Top" DataContext="{Binding Tags}" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Top" Classes="meta" Text="Nothing matches." IsVisible="{Binding IsEmpty}"
                                       Margin="0,8" />
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="flow:AbstractFlowPaletteItem">
                                            <Button Classes="pickerItem" Click="OnPickerItem">
                                                <StackPanel Spacing="2">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Key}" Classes="meta" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}" Classes="meta" TextWrapping="Wrap" MaxLines="2"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TagLine}" Classes="meta" FontSize="11" IsVisible="{Binding HasTags}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Border>
            </Panel>
        </Border>
        </DockPanel>
    </Grid>
</UserControl>
