<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:Afl.UI.DataContexts"
             x:Class="Afl.UI.Views.AuthorRequestView"
             x:DataType="dc:AuthorRequestDataContext">
    <StackPanel Spacing="10">
        <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Explanation}" />
        <TextBox x:Name="DescriptionBox" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                 MaxHeight="260" PlaceholderText="{Binding Placeholder}" />
        <HeaderedContentControl Header="Agent">
            <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding Agent}" MinWidth="200" />
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
